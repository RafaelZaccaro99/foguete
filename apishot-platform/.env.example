# Copiar para .env e preencher (nunca commitar o .env de verdade)

# Webhook / Meta
VERIFY_TOKEN=invente_uma_senha_aqui
# WHATSAPP_TOKEN é opcional aqui: dá pra configurar o token direto pela tela inicial
# (fica salvo no banco e tem prioridade sobre este). Deixe em branco se for usar a tela.
WHATSAPP_TOKEN=

# Banco de dados (criado no hPanel: Bancos de dados -> MySQL Databases)
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

PORT=3000
