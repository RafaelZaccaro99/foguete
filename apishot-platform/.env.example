# Copiar para .env e preencher (nunca commitar o .env de verdade)
# Em produção o app confere estas variáveis no boot e se recusa a subir se faltar algo
# importante — a mensagem de erro diz exatamente qual.

# production ativa: cookie de sessão Secure, HSTS e a validação estrita das variáveis
NODE_ENV=production

# Login do painel
PAINEL_SENHA=defina_uma_senha_forte    # senha do primeiro acesso (troque depois pela tela)
SESSION_SECRET=   # assina o cookie de sessão — gere com: openssl rand -hex 32

# Webhook / Meta
VERIFY_TOKEN=invente_uma_senha_aqui
META_APP_SECRET=          # App Secret do app da Meta — valida a assinatura do webhook (obrigatório em produção)
# WHATSAPP_TOKEN é opcional aqui: dá pra configurar o token direto pela tela inicial
# (fica salvo no banco e tem prioridade sobre este). Deixe em branco se for usar a tela.
WHATSAPP_TOKEN=

# Banco de dados (criado no hPanel: Bancos de dados -> MySQL Databases;
# no docker compose, DB_HOST é o nome do serviço: banco)
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

PORT=3000

# --- opcionais (os padrões servem pra maioria dos casos) ---
# TRUST_PROXY=1          # quantos proxies existem na frente do app (Hostinger/nginx/Render = 1)
# COOKIE_SECURE=true     # só mude pra false se realmente for servir em HTTP puro
# BOOTSTRAP_DB=false     # desliga o preparo automático do banco no boot (schema + migração + seed)

# --- usados só pelo docker compose ---
# DB_ROOT_PASS=          # senha do root do MySQL do container
# PORTA_EXTERNA=3000     # porta exposta na máquina host
