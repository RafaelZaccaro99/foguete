# Copiar para .env e preencher (nunca commitar o .env de verdade)

# Login do painel
PAINEL_SENHA=defina_uma_senha_forte    # senha inicial de acesso (troque depois pela tela)
SESSION_SECRET=cole_uma_string_aleatoria_longa_aqui   # assina o cookie de sessão

# Webhook / Meta
VERIFY_TOKEN=invente_uma_senha_aqui
META_APP_SECRET=          # App Secret do app da Meta — valida a assinatura do webhook (obrigatório em produção)
# WHATSAPP_TOKEN é opcional aqui: dá pra configurar o token direto pela tela inicial
# (fica salvo no banco e tem prioridade sobre este). Deixe em branco se for usar a tela.
WHATSAPP_TOKEN=

# Banco de dados (criado no hPanel: Bancos de dados -> MySQL Databases)
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

PORT=3000

# Email (opcional aqui: dá pra configurar tudo pela tela Email do painel,
# que fica salvo no banco e tem prioridade sobre estes)
SMTP_HOST=            # ex: smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=1         # 1 = SSL direto (porta 465); 0 = STARTTLS (porta 587)
EMAIL_FROM=           # ex: contato@seudominio.com.br
EMAIL_FROM_NAME=      # ex: Vendi+
EMAIL_BASE_URL=       # URL pública do painel (pros links de rastreio/descadastro)
